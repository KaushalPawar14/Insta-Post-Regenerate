# ---------------------------------------------------------------------------
# Copy to `.env.local` for local dev, and paste the same values into
# Vercel -> Project -> Settings -> Environment Variables for production.
# NEVER commit the filled-in file. `.env` and `.env.local` are gitignored.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Dashboard -> Project Settings -> Data API  (URL + anon key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_PUBLIC_KEY

# Dashboard -> Project Settings -> API Keys -> service_role (SECRET).
# Server-side only. Bypasses Row Level Security. Never expose to the browser
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# Storage bucket name (create it as a PRIVATE bucket -- schema.sql does this).
# NEXT_PUBLIC_ because the browser needs it to mint signed URLs for images.
# The bucket name is not a secret; access is controlled by RLS, not obscurity.
NEXT_PUBLIC_SUPABASE_BUCKET=generated

# --- Upstash QStash -------------------------------------------------------
# console.upstash.com -> QStash -> Details
QSTASH_TOKEN=REPLACE_WITH_QSTASH_TOKEN
QSTASH_CURRENT_SIGNING_KEY=REPLACE_WITH_CURRENT_SIGNING_KEY
QSTASH_NEXT_SIGNING_KEY=REPLACE_WITH_NEXT_SIGNING_KEY

# --- Paid APIs (you already have these) -----------------------------------
APIFY_TOKEN=REPLACE_WITH_APIFY_TOKEN
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY

# --- App configuration ----------------------------------------------------
# Public HTTPS origin of the deployed app. QStash calls back to this, so it
# MUST be the real public URL (no trailing slash). On Vercel this falls back
# to VERCEL_PROJECT_PRODUCTION_URL if unset, but setting it explicitly is
# safer because preview deployment URLs change on every push.
PUBLIC_BASE_URL=https://your-project.vercel.app

# Optional password gate. LEAVE UNSET/EMPTY for a fully open app (the default).
# Set it to any string to require visitors to enter it once before using the app.
SITE_PASSWORD=

# Image generation quality for gpt-image-2: low | medium | high | auto
# Defaults to `medium`. Rationale: Vercel's Hobby plan has a HARD 300s function
# ceiling, and `auto`/`high` at 1024x1536 has been benchmarked at ~195s median
# and ~280s worst case -- too close to the limit. `medium` keeps generation
# comfortably inside it. Raise this only if you move to a higher Vercel plan.
IMAGE_QUALITY=medium
